* Mailversand bei Abschluss eines KDEXT-Auftrags
DATA: lt_jest        TYPE TABLE OF jest,
      lv_end_set     TYPE abap_bool,
      lv_order       TYPE aufnr,
      lv_sent        TYPE abap_bool,
      lv_error_text  TYPE string.

DATA: lo_send_request TYPE REF TO cl_bcs,
      lo_document     TYPE REF TO cl_document_bcs,
      lo_recipient    TYPE REF TO if_recipient_bcs.

lv_order = caufvd_imp-aufnr.

* Prüfen ob Technischer Platz mit 'KDEXT' beginnt
IF lv_tplnr CP 'KDEXT*'.

  " Statusdaten lesen: Anwenderstatus 'END' = E0012
  SELECT * FROM jest INTO TABLE lt_jest
    WHERE objnr = caufvd_imp-objnr
      AND stat  = 'E0012'
      AND inact = ' '.

  IF sy-subrc = 0.
    lv_end_set = abap_true.
  ENDIF.

  IF lv_end_set = abap_true.

    TRY.
        " Mailversand vorbereiten
        lo_send_request = cl_bcs=>create_persistent( ).

        " Dokument erstellen
        lo_document = cl_document_bcs=>create_document(
          i_type    = 'RAW'
          i_subject = |KDEXT Auftrag { lv_order } abgeschlossen|
          i_text    = VALUE soli_tab(
            ( line = |KDEXT Auftrag { lv_order } wurde abgeschlossen.| )
            ( line = |Technischer Platz: { lv_tplnr }| )
            ( line = |Datum: { sy-datum } Zeit: { sy-uzeit }| )
          )
        ).
        lo_send_request->set_document( lo_document ).

        " Empfänger
        lo_recipient = cl_cam_address_bcs=>create_internet_address(
          'Test@hmailversand.de'
        ).
        lo_send_request->add_recipient( lo_recipient ).

        " Mail senden
        lv_sent = lo_send_request->send( i_with_error_screen = abap_true ).

        IF lv_sent = abap_true.
          " Erfolg protokollieren
          "MESSAGE i001(zmm_kdext) WITH lv_order. " Custom Message Class
        ELSE.
          " Fehler protokollieren
         "MESSAGE e002(zmm_kdext) WITH lv_order. " Custom Message Class
        ENDIF.

        " COMMIT WORK vermeiden - nur in Ausnahmefällen
        " COMMIT WORK AND WAIT.

      CATCH cx_bcs INTO DATA(lx_bcs).
        " Fehlerbehandlung
        lv_error_text = lx_bcs->get_text( ).
        "MESSAGE e003(zmm_kdext) WITH lv_order lv_error_text.
    ENDTRY.

  ENDIF.
ENDIF.
