FORM prepare_rfc_fields_2.

  DATA: lv_jfz TYPE fieldname.

  REFRESH gt_fields2.
  CLEAR: gv_header2_extra, gv_fcnt2_extra, gv_empty2.

* Alle Verknüpfungsfelder der Zusatztabelle werden immer zuerst
* gelesen (in der Reihenfolge von gt_jfz; bilden zusammen den
* Schlüssel für den Lookup)
  LOOP AT gt_jfz INTO lv_jfz.
    CLEAR gs_fields.
    gs_fields-fieldname = lv_jfz.
    APPEND gs_fields TO gt_fields2.
  ENDLOOP.

  LOOP AT gt_fld2 INTO gs_fld2.

    READ TABLE gt_jfz WITH KEY table_line = gs_fld2-fieldname TRANSPORTING NO FIELDS.
    IF sy-subrc EQ 0.
      CONTINUE.
    ENDIF.

    CLEAR gs_fields.
    gs_fields-fieldname = gs_fld2-fieldname.
    APPEND gs_fields TO gt_fields2.

    gv_fcnt2_extra = gv_fcnt2_extra + 1.

    IF gv_header2_extra IS INITIAL.
      gv_header2_extra = gs_fld2-fieldname.
    ELSE.
      CONCATENATE gv_header2_extra gs_fld2-fieldname INTO gv_header2_extra
        SEPARATED BY gv_sep.
    ENDIF.

  ENDLOOP.

  IF gv_fcnt2_extra IS INITIAL.
    MESSAGE 'Es wurde kein Ausgabefeld für die Zusatztabelle ausgewählt' TYPE 'E'.
  ENDIF.

* Leerplatzhalter für nicht gefundene Verknüpfungen
  CLEAR gv_empty2.
  DO gv_fcnt2_extra TIMES.
    IF sy-index EQ 1.
      gv_empty2 = ''.
    ELSE.
      CONCATENATE gv_empty2 gv_sep INTO gv_empty2.
    ENDIF.
  ENDDO.

ENDFORM.

FORM read_table_data_2.

  REFRESH: gt_options2, gt_data2.

  PERFORM build_zusatz_where_options CHANGING gt_options2.

  CALL FUNCTION 'RFC_READ_TABLE'
    EXPORTING
      query_table          = gv_tabname2
      delimiter            = gv_sep
      no_data              = space
      rowskips             = 0
      rowcount             = 0
    TABLES
      options              = gt_options2
      fields               = gt_fields2
      data                 = gt_data2
    EXCEPTIONS
      table_not_available  = 1
      table_without_data   = 2
      option_not_valid     = 3
      field_not_valid      = 4
      not_authorized       = 5
      data_buffer_exceeded = 6
      OTHERS               = 7.

  IF sy-subrc EQ 1.
    MESSAGE 'Zusatztabelle ist nicht verfügbar' TYPE 'E'.
  ELSEIF sy-subrc EQ 2.
*   Zusatztabelle ohne Daten ist kein Abbruchgrund, Lookup bleibt leer
    CLEAR sy-subrc.
  ELSEIF sy-subrc EQ 3.
    MESSAGE 'Selektion der Zusatztabelle ist ungültig' TYPE 'E'.
  ELSEIF sy-subrc EQ 4.
    MESSAGE 'Mindestens ein Feld der Zusatztabelle ist ungültig' TYPE 'E'.
  ELSEIF sy-subrc EQ 5.
    MESSAGE 'Keine Berechtigung für den Zugriff auf die Zusatztabelle' TYPE 'E'.
  ELSEIF sy-subrc EQ 6.
    MESSAGE 'Ergebniszeile der Zusatztabelle ist zu breit; weniger Zusatzfelder auswählen' TYPE 'E'.
  ELSEIF sy-subrc NE 0.
    MESSAGE 'Fehler beim Lesen der Zusatztabelle' TYPE 'E'.
  ENDIF.

ENDFORM.

FORM build_lookup_table.

  DATA: lt_parts    TYPE STANDARD TABLE OF string,
        lv_part     TYPE string,
        lv_key      TYPE c LENGTH 200,
        lv_key_part TYPE c LENGTH 200,
        lv_value    TYPE c LENGTH 4096,
        lv_first    TYPE c LENGTH 1,
        lv_jf_cnt   TYPE i,
        lv_start    TYPE i,
        lv_idx      TYPE i.

  REFRESH gt_lookup.

  DESCRIBE TABLE gt_jfz LINES lv_jf_cnt.
  lv_start = lv_jf_cnt + 1.

  LOOP AT gt_data2 INTO gs_data2.

    REFRESH lt_parts.
    SPLIT gs_data2-wa AT gv_sep INTO TABLE lt_parts.

*   Zusammengesetzten Schlüssel aus den ersten lv_jf_cnt Werten
*   bilden (= die Verknüpfungsfelder, siehe prepare_rfc_fields_2)
    CLEAR lv_key.
    DO lv_jf_cnt TIMES.
      lv_idx = sy-index.
      CLEAR lv_key_part.
      READ TABLE lt_parts INTO lv_part INDEX lv_idx.
      IF sy-subrc EQ 0.
        lv_key_part = lv_part.
        CONDENSE lv_key_part.
      ENDIF.
      IF lv_idx EQ 1.
        lv_key = lv_key_part.
      ELSE.
        CONCATENATE lv_key gv_key_sep lv_key_part INTO lv_key.
      ENDIF.
    ENDDO.

    CLEAR: lv_value, lv_first.
    lv_first = 'X'.

    LOOP AT lt_parts INTO lv_part FROM lv_start.
      IF lv_first EQ 'X'.
        lv_value = lv_part.
        lv_first = space.
      ELSE.
        CONCATENATE lv_value lv_part INTO lv_value SEPARATED BY gv_sep.
      ENDIF.
    ENDLOOP.

    CLEAR gs_lookup.
    gs_lookup-lookup_key = lv_key.
    gs_lookup-lookup_val = lv_value.
    APPEND gs_lookup TO gt_lookup.

  ENDLOOP.

ENDFORM.

