FORM read_table_data.

  REFRESH gt_options.
  REFRESH gt_data.

  PERFORM build_main_where_options CHANGING gt_options.

* Kein CLIENT SPECIFIED, keine explizite Zeilenbegrenzung.
* RFC_READ_TABLE liest mandantenabhängige Tabellen im aktuellen Mandanten.
* Optionale WHERE-Bedingung siehe build_main_where_options (Filterfelder).
  CALL FUNCTION 'RFC_READ_TABLE'
    EXPORTING
      query_table          = gv_tabname
      delimiter            = gv_sep
      no_data              = space
      rowskips             = 0
      rowcount             = 0
    TABLES
      options              = gt_options
      fields               = gt_fields
      data                 = gt_data
    EXCEPTIONS
      table_not_available  = 1
      table_without_data   = 2
      option_not_valid     = 3
      field_not_valid      = 4
      not_authorized       = 5
      data_buffer_exceeded = 6
      OTHERS               = 7.

  IF sy-subrc EQ 1.
    MESSAGE 'Tabelle ist nicht verfügbar' TYPE 'E'.
  ELSEIF sy-subrc EQ 2.
    MESSAGE 'Tabelle enthält keine Daten' TYPE 'S'.
  ELSEIF sy-subrc EQ 3.
    MESSAGE 'Selektion ist ungültig' TYPE 'E'.
  ELSEIF sy-subrc EQ 4.
    MESSAGE 'Mindestens ein Feld ist ungültig' TYPE 'E'.
  ELSEIF sy-subrc EQ 5.
    MESSAGE 'Keine Berechtigung für den Tabellenzugriff' TYPE 'E'.
  ELSEIF sy-subrc EQ 6.
    MESSAGE 'Ergebniszeile ist zu breit für RFC_READ_TABLE; weniger Felder auswählen' TYPE 'E'.
  ELSEIF sy-subrc NE 0.
    MESSAGE 'Fehler beim Lesen der Tabelle' TYPE 'E'.
  ENDIF.

ENDFORM.

FORM build_download_table.

  DATA: lt_jfh_pos  TYPE STANDARD TABLE OF i,
        lv_pos      TYPE i,
        lv_idx      TYPE i,
        lv_i        TYPE i,
        lv_jfh      TYPE fieldname,
        lt_parts    TYPE STANDARD TABLE OF string,
        lv_part     TYPE string,
        lv_key      TYPE c LENGTH 200,
        lv_key_part TYPE c LENGTH 200,
        lv_value    TYPE c LENGTH 4096,
        lv_found    TYPE c LENGTH 1,
        lv_datum    TYPE c LENGTH 10,
        lv_uhrzeit  TYPE c LENGTH 8.

  REFRESH gt_csv.

  IF p_tab2 IS NOT INITIAL.

*   Positionen aller Verknüpfungsfelder innerhalb der ausgewählten
*   Hauptfelder ermitteln (für den Split der Pipe-Zeile), in der
*   Reihenfolge von gt_jfh (= Reihenfolge der Feldpaare 1..4)
    REFRESH lt_jfh_pos.

    LOOP AT gt_jfh INTO lv_jfh.

      CLEAR lv_pos.
      lv_idx = 0.
      LOOP AT gt_fld INTO gs_fld.
        lv_idx = lv_idx + 1.
        IF gs_fld-fieldname = lv_jfh.
          lv_pos = lv_idx.
          EXIT.
        ENDIF.
      ENDLOOP.

      IF lv_pos IS INITIAL.
        MESSAGE 'Ein Verknüpfungsfeld der Haupttabelle ist nicht in der Feldauswahl enthalten' TYPE 'E'.
      ENDIF.

      APPEND lv_pos TO lt_jfh_pos.

    ENDLOOP.

  ENDIF.

* Info-Kopfzeile: Erstellungsdatum/-zeit des Exports
  CONCATENATE sy-datum+6(2) '.' sy-datum+4(2) '.' sy-datum(4) INTO lv_datum.
  CONCATENATE sy-uzeit(2) ':' sy-uzeit+2(2) ':' sy-uzeit+4(2) INTO lv_uhrzeit.

  CLEAR gs_csv.
  gs_csv-line = |Erstellt am { lv_datum } { lv_uhrzeit }|.
  APPEND gs_csv TO gt_csv.

* Kopfzeile (Spaltennamen)
  CLEAR gs_csv.
  gs_csv-line = gv_header.
  APPEND gs_csv TO gt_csv.

* Datenzeilen
  LOOP AT gt_data INTO gs_data.

    CLEAR gs_csv.
    gs_csv-line = gs_data-wa.

    IF p_tab2 IS NOT INITIAL.

      REFRESH lt_parts.
      SPLIT gs_data-wa AT gv_sep INTO TABLE lt_parts.

*     Zusammengesetzten Schlüssel aus allen Verknüpfungsfeldern
*     der Haupttabelle bilden (gleiche Reihenfolge/Trenner wie
*     beim Aufbau von gt_lookup in build_lookup_table)
      CLEAR lv_key.
      lv_i = 0.
      LOOP AT lt_jfh_pos INTO lv_pos.
        lv_i = lv_i + 1.
        CLEAR lv_key_part.
        READ TABLE lt_parts INTO lv_part INDEX lv_pos.
        IF sy-subrc EQ 0.
          lv_key_part = lv_part.
          CONDENSE lv_key_part.
        ENDIF.
        IF lv_i EQ 1.
          lv_key = lv_key_part.
        ELSE.
          CONCATENATE lv_key gv_key_sep lv_key_part INTO lv_key.
        ENDIF.
      ENDLOOP.

      CLEAR: lv_value, lv_found.
      READ TABLE gt_lookup INTO gs_lookup WITH KEY lookup_key = lv_key.
      IF sy-subrc EQ 0.
        lv_value = gs_lookup-lookup_val.
        lv_found = 'X'.
      ENDIF.

      IF lv_found IS INITIAL.
        lv_value = gv_empty2.
      ENDIF.

      CONCATENATE gs_csv-line lv_value INTO gs_csv-line SEPARATED BY gv_sep.

    ENDIF.

    APPEND gs_csv TO gt_csv.

  ENDLOOP.

ENDFORM.

FORM download_file.

  OPEN DATASET p_file
    FOR OUTPUT
    IN TEXT MODE
    ENCODING DEFAULT.
  IF sy-subrc NE 0.
    MESSAGE 'Serverdatei konnte nicht geoeffnet werden' TYPE 'E'.
  ENDIF.

  LOOP AT gt_csv INTO gs_csv.
    TRANSFER gs_csv-line TO p_file.
    IF sy-subrc NE 0.
      CLOSE DATASET p_file.
      MESSAGE 'Fehler beim Schreiben der Serverdatei' TYPE 'E'.
    ENDIF.
  ENDLOOP.

  CLOSE DATASET p_file.

  MESSAGE 'Datei erfolgreich auf dem Applikationsserver erstellt' TYPE 'S'.

ENDFORM.

