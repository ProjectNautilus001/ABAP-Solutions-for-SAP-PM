FORM save_field_list.

  DATA: lv_len1 TYPE i,
        lv_len2 TYPE i,
        lv_sum  TYPE i.

  CLEAR p_flds.

* Feldliste mit führendem und abschliessendem Komma speichern.
* Dadurch kann beim Wiederherstellen exakt gesucht werden.
* Beispiel: ,MANDT,AUFNR,ERDAT,
  LOOP AT gt_fld INTO gs_fld.

    lv_len1 = STRLEN( p_flds ).
    lv_len2 = STRLEN( gs_fld-fieldname ).
    lv_sum  = lv_len1 + lv_len2 + 1.

    IF lv_sum GT 255.
      MESSAGE 'Feldliste für Variante ist länger als 255 Zeichen; Auswahl wurde gekürzt' TYPE 'I'.
      EXIT.
    ENDIF.

    IF p_flds IS INITIAL.
      CONCATENATE ',' gs_fld-fieldname ',' INTO p_flds.
    ELSE.
      CONCATENATE p_flds gs_fld-fieldname ',' INTO p_flds.
    ENDIF.

  ENDLOOP.

ENDFORM.

FORM restore_field_list.

  DATA: lv_find TYPE c LENGTH 40.

  LOOP AT gt_fld INTO gs_fld.

    CLEAR lv_find.
    CONCATENATE ',' gs_fld-fieldname ',' INTO lv_find.

    IF p_flds CS lv_find.
      gs_fld-mark = 'X'.
      MODIFY gt_fld FROM gs_fld.
    ENDIF.

  ENDLOOP.

  DELETE gt_fld WHERE mark IS INITIAL.
  DESCRIBE TABLE gt_fld LINES gv_fcnt.

  gv_selected_tab = gv_tabname.

ENDFORM.

