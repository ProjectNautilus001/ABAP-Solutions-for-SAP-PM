SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME.
PARAMETERS: p_tab       TYPE tabname OBLIGATORY,
            p_file      TYPE string OBLIGATORY,
            p_flds(255) TYPE c NO-DISPLAY.

SELECTION-SCREEN SKIP.
SELECTION-SCREEN PUSHBUTTON /1(25) gv_btn USER-COMMAND feld.
SELECTION-SCREEN COMMENT /1(70) gv_stat.
SELECTION-SCREEN END OF BLOCK b1.

SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME.
PARAMETERS: p_tab2       TYPE tabname,
            p_jf1h       TYPE fieldname,
            p_jf1z       TYPE fieldname,
            p_jf2h       TYPE fieldname,
            p_jf2z       TYPE fieldname,
            p_jf3h       TYPE fieldname,
            p_jf3z       TYPE fieldname,
            p_jf4h       TYPE fieldname,
            p_jf4z       TYPE fieldname,
            p_flds2(255) TYPE c NO-DISPLAY.

SELECTION-SCREEN SKIP.
SELECTION-SCREEN PUSHBUTTON /1(25) gv_btn2 USER-COMMAND feld2.
SELECTION-SCREEN COMMENT /1(70) gv_stat2.
SELECTION-SCREEN END OF BLOCK b2.

SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME.
PARAMETERS: p_flt1h  TYPE fieldname,
            p_flt1hv TYPE c LENGTH 40,
            p_flt1hb TYPE c LENGTH 40.
SELECTION-SCREEN SKIP.
PARAMETERS: p_flt2h  TYPE fieldname,
            p_flt2hv TYPE c LENGTH 40,
            p_flt2hb TYPE c LENGTH 40.
SELECTION-SCREEN SKIP.
PARAMETERS: p_flt1z  TYPE fieldname,
            p_flt1zv TYPE c LENGTH 40,
            p_flt1zb TYPE c LENGTH 40.
SELECTION-SCREEN SKIP.
PARAMETERS: p_flt2z  TYPE fieldname,
            p_flt2zv TYPE c LENGTH 40,
            p_flt2zb TYPE c LENGTH 40.
SELECTION-SCREEN END OF BLOCK b3.


INITIALIZATION.
  %_p_tab_%_app_%-text  = 'Tabelle'.
  %_p_file_%_app_%-text = 'Zieldatei SAP-Server / hW-HDD'.
  %_p_tab2_%_app_%-text = 'Zusatztabelle (optional)'.
  %_p_jf1h_%_app_%-text = 'Verkn.-Feld 1 Haupttabelle'.
  %_p_jf1z_%_app_%-text = 'Verkn.-Feld 1 Zusatztabelle'.
  %_p_jf2h_%_app_%-text = 'Verkn.-Feld 2 Haupttabelle'.
  %_p_jf2z_%_app_%-text = 'Verkn.-Feld 2 Zusatztabelle'.
  %_p_jf3h_%_app_%-text = 'Verkn.-Feld 3 Haupttabelle'.
  %_p_jf3z_%_app_%-text = 'Verkn.-Feld 3 Zusatztabelle'.
  %_p_jf4h_%_app_%-text = 'Verkn.-Feld 4 Haupttabelle'.
  %_p_jf4z_%_app_%-text = 'Verkn.-Feld 4 Zusatztabelle'.
  %_p_flt1h_%_app_%-text  = 'Filterfeld 1 Haupttabelle'.
  %_p_flt1hv_%_app_%-text = 'Wert von (Filter 1 Haupt)'.
  %_p_flt1hb_%_app_%-text = 'Wert bis (Filter 1 Haupt)'.
  %_p_flt2h_%_app_%-text  = 'Filterfeld 2 Haupttabelle'.
  %_p_flt2hv_%_app_%-text = 'Wert von (Filter 2 Haupt)'.
  %_p_flt2hb_%_app_%-text = 'Wert bis (Filter 2 Haupt)'.
  %_p_flt1z_%_app_%-text  = 'Filterfeld 1 Zusatztabelle'.
  %_p_flt1zv_%_app_%-text = 'Wert von (Filter 1 Zusatz)'.
  %_p_flt1zb_%_app_%-text = 'Wert bis (Filter 1 Zusatz)'.
  %_p_flt2z_%_app_%-text  = 'Filterfeld 2 Zusatztabelle'.
  %_p_flt2zv_%_app_%-text = 'Wert von (Filter 2 Zusatz)'.
  %_p_flt2zb_%_app_%-text = 'Wert bis (Filter 2 Zusatz)'.
  gv_sep   = '|'.
  gv_btn   = 'Felder auswählen'.
  gv_stat  = 'Noch keine Felder ausgewählt'.
  gv_btn2  = 'Zusatzfelder auswählen'.
  gv_stat2 = 'Keine Zusatztabelle gewählt'.


AT SELECTION-SCREEN OUTPUT.

  gv_btn  = 'Felder auswählen'.
  gv_btn2 = 'Zusatzfelder auswählen'.

  IF gv_fcnt IS INITIAL.
    IF p_flds IS INITIAL.
      gv_stat = 'Noch keine Felder ausgewählt'.
    ELSE.
      gv_stat = 'Feldliste aus Variante vorhanden'.
    ENDIF.
  ELSE.
    CLEAR: gv_stat,
           gv_cntxt.
    WRITE gv_fcnt TO gv_cntxt LEFT-JUSTIFIED.
    CONCATENATE 'Ausgewählte Felder:' gv_cntxt
           INTO gv_stat SEPARATED BY space.
    IF gv_selected_tab IS NOT INITIAL.
      CONCATENATE gv_stat 'für Tabelle' gv_selected_tab
             INTO gv_stat SEPARATED BY space.
    ENDIF.
  ENDIF.

  IF p_tab2 IS INITIAL.
    gv_stat2 = 'Keine Zusatztabelle gewählt'.
  ELSEIF gv_fcnt2 IS INITIAL.
    IF p_flds2 IS INITIAL.
      gv_stat2 = 'Noch keine Zusatzfelder ausgewählt'.
    ELSE.
      gv_stat2 = 'Zusatzfeldliste aus Variante vorhanden'.
    ENDIF.
  ELSE.
    CLEAR: gv_stat2,
           gv_cntxt.
    WRITE gv_fcnt2 TO gv_cntxt LEFT-JUSTIFIED.
    CONCATENATE 'Ausgewählte Zusatzfelder:' gv_cntxt
           INTO gv_stat2 SEPARATED BY space.
    IF gv_selected_tab2 IS NOT INITIAL.
      CONCATENATE gv_stat2 'für Tabelle' gv_selected_tab2
             INTO gv_stat2 SEPARATED BY space.
    ENDIF.
  ENDIF.

AT SELECTION-SCREEN.

  CASE sy-ucomm.
    WHEN 'FELD'.

      IF p_tab IS INITIAL.
        MESSAGE 'Bitte zuerst eine Tabelle eingeben' TYPE 'I'.
        LEAVE SCREEN.
      ENDIF.

      gv_tabname = p_tab.
      TRANSLATE gv_tabname TO UPPER CASE.

      PERFORM check_table_exists.
      PERFORM read_field_catalog.
      PERFORM popup_select_fields.
      PERFORM count_selected_fields.
      PERFORM save_field_list.

      gv_selected_tab = gv_tabname.
      LEAVE SCREEN.

    WHEN 'FELD2'.

      IF p_tab2 IS INITIAL.
        MESSAGE 'Bitte zuerst eine Zusatztabelle eingeben' TYPE 'I'.
        LEAVE SCREEN.
      ENDIF.

      gv_tabname2 = p_tab2.
      TRANSLATE gv_tabname2 TO UPPER CASE.

      PERFORM check_table_exists_2.
      PERFORM read_field_catalog_2.
      PERFORM popup_select_fields_2.
      PERFORM count_selected_fields_2.
      PERFORM save_field_list_2.

      gv_selected_tab2 = gv_tabname2.
      LEAVE SCREEN.

  ENDCASE.

START-OF-SELECTION.

  gv_tabname = p_tab.
  TRANSLATE gv_tabname TO UPPER CASE.

  IF gt_fld IS INITIAL AND p_flds IS NOT INITIAL.
    PERFORM check_table_exists.
    PERFORM read_field_catalog.
    PERFORM restore_field_list.
  ENDIF.

  IF gt_fld IS INITIAL.
    MESSAGE 'Bitte zuerst Felder über den Button auswählen' TYPE 'E'.
  ENDIF.

  IF gv_selected_tab IS NOT INITIAL AND gv_selected_tab NE gv_tabname.
    MESSAGE 'Tabelle wurde geändert; bitte Felder erneut auswählen' TYPE 'E'.
  ENDIF.

* Optionale Zusatztabelle (Lookup/Join)
  IF p_tab2 IS NOT INITIAL.

    gv_tabname2 = p_tab2.
    TRANSLATE gv_tabname2 TO UPPER CASE.

    PERFORM collect_join_fields.

    IF gt_fld2 IS INITIAL AND p_flds2 IS NOT INITIAL.
      PERFORM check_table_exists_2.
      PERFORM read_field_catalog_2.
      PERFORM restore_field_list_2.
    ENDIF.

    IF gt_fld2 IS INITIAL.
      MESSAGE 'Bitte zuerst Zusatzfelder über den Button auswählen' TYPE 'E'.
    ENDIF.

    IF gv_selected_tab2 IS NOT INITIAL AND gv_selected_tab2 NE gv_tabname2.
      MESSAGE 'Zusatztabelle wurde geändert; bitte Zusatzfelder erneut auswählen' TYPE 'E'.
    ENDIF.

    PERFORM prepare_rfc_fields_2.
    PERFORM read_table_data_2.
    PERFORM build_lookup_table.

  ENDIF.

  PERFORM prepare_rfc_fields.

  IF p_tab2 IS NOT INITIAL AND gv_header2_extra IS NOT INITIAL.
    CONCATENATE gv_header gv_header2_extra INTO gv_header SEPARATED BY gv_sep.
  ENDIF.

  PERFORM read_table_data.
  PERFORM build_download_table.
  PERFORM download_file.

FORM collect_join_fields.

* Sammelt bis zu 4 Verknüpfungsfeldpaare (Haupttabelle/Zusatztabelle)
* in gt_jfh / gt_jfz. Jedes Paar muss vollständig gefüllt oder
* vollständig leer sein. Mindestens Paar 1 muss gefüllt sein.

  REFRESH: gt_jfh, gt_jfz.

  IF p_jf1h IS NOT INITIAL OR p_jf1z IS NOT INITIAL.
    IF p_jf1h IS INITIAL OR p_jf1z IS INITIAL.
      MESSAGE 'Verknüpfungsfeldpaar 1: Haupt- und Zusatztabellenfeld müssen beide gefüllt sein' TYPE 'E'.
    ENDIF.
    APPEND p_jf1h TO gt_jfh.
    APPEND p_jf1z TO gt_jfz.
  ENDIF.

  IF p_jf2h IS NOT INITIAL OR p_jf2z IS NOT INITIAL.
    IF p_jf2h IS INITIAL OR p_jf2z IS INITIAL.
      MESSAGE 'Verknüpfungsfeldpaar 2: Haupt- und Zusatztabellenfeld müssen beide gefüllt sein' TYPE 'E'.
    ENDIF.
    APPEND p_jf2h TO gt_jfh.
    APPEND p_jf2z TO gt_jfz.
  ENDIF.

  IF p_jf3h IS NOT INITIAL OR p_jf3z IS NOT INITIAL.
    IF p_jf3h IS INITIAL OR p_jf3z IS INITIAL.
      MESSAGE 'Verknüpfungsfeldpaar 3: Haupt- und Zusatztabellenfeld müssen beide gefüllt sein' TYPE 'E'.
    ENDIF.
    APPEND p_jf3h TO gt_jfh.
    APPEND p_jf3z TO gt_jfz.
  ENDIF.

  IF p_jf4h IS NOT INITIAL OR p_jf4z IS NOT INITIAL.
    IF p_jf4h IS INITIAL OR p_jf4z IS INITIAL.
      MESSAGE 'Verknüpfungsfeldpaar 4: Haupt- und Zusatztabellenfeld müssen beide gefüllt sein' TYPE 'E'.
    ENDIF.
    APPEND p_jf4h TO gt_jfh.
    APPEND p_jf4z TO gt_jfz.
  ENDIF.

  IF gt_jfh IS INITIAL.
    MESSAGE 'Bitte mindestens ein Verknüpfungsfeldpaar für Haupt- und Zusatztabelle angeben' TYPE 'E'.
  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Forms für optionale Selektionsfilter (WHERE-Bedingungen)
*&---------------------------------------------------------------------*

FORM convert_date_value CHANGING cv_val TYPE c.

* Wandelt eine Eingabe im Format TT.MM.JJJJ in das interne
* Datumsformat JJJJMMTT um. Andere Formate (z. B. bereits JJJJMMTT)
* bleiben unverändert.

  DATA: lv_len TYPE i.

  CONDENSE cv_val.
  lv_len = strlen( cv_val ).

  IF lv_len EQ 10 AND cv_val+2(1) EQ '.' AND cv_val+5(1) EQ '.'.
    DATA(lv_new) = cv_val+6(4) && cv_val+3(2) && cv_val+0(2).
    cv_val = lv_new.
  ENDIF.

ENDFORM.

FORM append_where_line USING pv_clause TYPE string
                     CHANGING ct_options TYPE STANDARD TABLE.

* Hängt einen WHERE-Textbaustein an die RFC_READ_TABLE-OPTIONS an.
* RFC_READ_TABLE fügt alle TEXT-Zeilen beim Aufbau der Bedingung
* einfach aneinander, daher ist ein Umbruch an einer beliebigen
* Zeichenposition (max. 72 Zeichen je Zeile) unkritisch.

  DATA: lv_rest TYPE string,
        lv_len  TYPE i,
        ls_opt  TYPE rfc_db_opt.

  lv_rest = pv_clause.

  WHILE strlen( lv_rest ) > 0.
    lv_len = strlen( lv_rest ).
    IF lv_len > 72.
      lv_len = 72.
    ENDIF.

    CLEAR ls_opt.
    ls_opt-text = lv_rest(lv_len).
    APPEND ls_opt TO ct_options.

    lv_rest = lv_rest+lv_len.
  ENDWHILE.

ENDFORM.

FORM add_range_filter USING pv_field    TYPE fieldname
                             pv_von     TYPE c
                             pv_bis     TYPE c
                             pv_use_main TYPE c
                     CHANGING ct_options TYPE STANDARD TABLE.

* Baut aus Feldname + Wert von/bis einen WHERE-Baustein und hängt
* ihn (ggf. mit vorangestelltem AND) an ct_options an. pv_use_main =
* 'X' -> Datentyp aus dem Katalog der Haupttabelle (gt_dd03p)
* ermitteln, sonst aus dem der Zusatztabelle (gt_dd03p2). Bei
* Datumsfeldern (INTTYPE 'D') wird TT.MM.JJJJ automatisch gewandelt.
* Ist nur "von" oder nur "bis" gefüllt, wird >= bzw. <= verwendet,
* sind beide gefüllt, wird ein Bereich (>= ... AND <= ...) gebildet.

  DATA: lv_field   TYPE fieldname,
        lv_inttype TYPE dd03p-inttype,
        lv_von     TYPE c LENGTH 40,
        lv_bis     TYPE c LENGTH 40,
        lv_clause  TYPE string,
        ls_main    TYPE dd03p,
        ls_zusatz  TYPE dd03p.

  IF pv_field IS INITIAL.
    RETURN.
  ENDIF.

  IF pv_von IS INITIAL AND pv_bis IS INITIAL.
    RETURN.
  ENDIF.

  lv_field = pv_field.
  TRANSLATE lv_field TO UPPER CASE.

  CLEAR lv_inttype.
  IF pv_use_main EQ 'X'.
    READ TABLE gt_dd03p INTO ls_main WITH KEY fieldname = lv_field.
    IF sy-subrc EQ 0.
      lv_inttype = ls_main-inttype.
    ENDIF.
  ELSE.
    READ TABLE gt_dd03p2 INTO ls_zusatz WITH KEY fieldname = lv_field.
    IF sy-subrc EQ 0.
      lv_inttype = ls_zusatz-inttype.
    ENDIF.
  ENDIF.

  lv_von = pv_von.
  lv_bis = pv_bis.

  IF lv_inttype EQ 'D'.
    PERFORM convert_date_value CHANGING lv_von.
    PERFORM convert_date_value CHANGING lv_bis.
  ENDIF.

  CONDENSE lv_von.
  CONDENSE lv_bis.

  CLEAR lv_clause.
  IF lv_von IS NOT INITIAL AND lv_bis IS NOT INITIAL.
    lv_clause = |{ lv_field } >= '{ lv_von }' AND { lv_field } <= '{ lv_bis }'|.
  ELSEIF lv_von IS NOT INITIAL.
    lv_clause = |{ lv_field } >= '{ lv_von }'|.
  ELSEIF lv_bis IS NOT INITIAL.
    lv_clause = |{ lv_field } <= '{ lv_bis }'|.
  ENDIF.

  IF lv_clause IS INITIAL.
    RETURN.
  ENDIF.

  IF lines( ct_options ) > 0.
    lv_clause = |AND { lv_clause }|.
  ENDIF.

  PERFORM append_where_line USING lv_clause CHANGING ct_options.

ENDFORM.

FORM build_main_where_options CHANGING ct_options TYPE STANDARD TABLE.

  PERFORM add_range_filter USING p_flt1h p_flt1hv p_flt1hb 'X'
                          CHANGING ct_options.
  PERFORM add_range_filter USING p_flt2h p_flt2hv p_flt2hb 'X'
                          CHANGING ct_options.

ENDFORM.

FORM build_zusatz_where_options CHANGING ct_options TYPE STANDARD TABLE.

  PERFORM add_range_filter USING p_flt1z p_flt1zv p_flt1zb space
                          CHANGING ct_options.
  PERFORM add_range_filter USING p_flt2z p_flt2zv p_flt2zb space
                          CHANGING ct_options.

ENDFORM.

FORM check_table_exists.

  DATA: lv_tabclass TYPE dd02l-tabclass.

  CLEAR lv_tabclass.

  SELECT SINGLE tabclass
    INTO lv_tabclass
    FROM dd02l
    WHERE tabname  = gv_tabname
      AND as4local = 'A'
      AND as4vers  = '0000'.

  IF sy-subrc NE 0.
    MESSAGE 'Tabelle wurde im DDIC nicht gefunden oder ist nicht aktiv' TYPE 'E'.
  ENDIF.

  IF lv_tabclass NE 'TRANSP' AND lv_tabclass NE 'VIEW'.
    MESSAGE 'Es sind nur transparente Tabellen oder Views vorgesehen' TYPE 'E'.
  ENDIF.

ENDFORM.

FORM read_field_catalog.

  DATA: ls_get_state TYPE dctablget,
        lv_lines     TYPE i.

  REFRESH gt_dd03p.
  REFRESH gt_fld.
  CLEAR ls_get_state.

  ls_get_state-tabd = 'A'.
  ls_get_state-tabt = 'A'.

  CALL FUNCTION 'DD_TABL_GET'
    EXPORTING
      get_state    = ls_get_state
      prid         = -2
      tabl_name    = gv_tabname
      withtext     = 'X'
      add_typeinfo = 'X'
    TABLES
      dd03p_tab_a  = gt_dd03p
    EXCEPTIONS
      OTHERS       = 1.

  DESCRIBE TABLE gt_dd03p LINES lv_lines.

  IF sy-subrc NE 0 OR lv_lines IS INITIAL.
    MESSAGE 'Feldinformationen konnten nicht gelesen werden' TYPE 'E'.
  ENDIF.

  LOOP AT gt_dd03p INTO gs_dd03p.
    CLEAR gs_fld.
    MOVE-CORRESPONDING gs_dd03p TO gs_fld.
    APPEND gs_fld TO gt_fld.
  ENDLOOP.

* .INCLUDE, .APPEND und technische Zeilen entfernen
  DELETE gt_fld WHERE inttype IS INITIAL.

ENDFORM.

